VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@example.com
DATABASE_URL=

# Lyrics provider: keep this server-side; do not use an OpenAI key here.
# LRCLIB requires no key and is used for live display by default.
# Other supported modes: musixmatch (requires key) or link (source-search fallback).
LYRICS_PROVIDER=lrclib
MUSIXMATCH_API_KEY=
# Keep false for LRCLIB unless you have separately verified storage/redistribution rights.
LYRICS_PERSISTENCE_ALLOWED=false
# Only set true for LRCLIB after confirming you have the right to cache its lyric content.
LRCLIB_CACHE_ALLOWED=false
LRCLIB_USER_AGENT=LichCuaVy-Karaoke/1.0 (https://github.com/taitottinhday/lichptv)
LYRICS_PUBLIC_LOOKUP_ENABLED=true
