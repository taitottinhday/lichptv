VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@example.com
DATABASE_URL=

# Lyrics provider: keep this server-side; do not use an OpenAI key here.
LYRICS_PROVIDER=musixmatch
MUSIXMATCH_API_KEY=
# Set true only after your provider plan explicitly permits storing lyrics offline.
LYRICS_PERSISTENCE_ALLOWED=false
